# Para XAMPP/Apache: bloquear acceso directo a datos internos
<FilesMatch "^(config|router)\.php$">
    Require all denied
</FilesMatch>
RedirectMatch 403 ^/?(.*/)?(datos|respaldos)(/.*)?$

# Trozos más grandes = subida más rápida (opcional; con los valores por defecto también funciona)
<IfModule mod_php.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 70M
    php_value max_execution_time 0
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 70M
    php_value max_execution_time 0
</IfModule>
