<?xml version="1.0" encoding="utf-8"?>
<!-- La PC de la casa usa http:// (sin certificado), así que se permite tráfico sin cifrar.
     Los datos viajan solo por la red WiFi local. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
